      "boundElements": null,
      "updated": 1749200550418,
      "link": null,
      "locked": false,
      "text": "src/\n├── components/\n│   ├── auth/\n│   │   ├── LoginForm.jsx\n│   │   └── SignupForm.jsx\n│   │\n│   ├── session/\n│   │   ├── SessionCard.jsx    # Session listing\n│   │   ├── Timer.jsx         # Shared Pomodoro timer\n│   │   └── ProgressBar.jsx   # Group progress\n│   │\n│   ├── ui/\n│   │   ├── Button.jsx\n│   │   ├── Modal.jsx\n│   │   └── Alert.jsx\n│   │\n│   └── focus/\n│       ├── DistractionShieldToggle.jsx\n│       └── GoalInput.jsx\n│\n├── pages/\n│   ├── Home.jsx              # Landing\n│   ├── Dashboard.jsx         # Main view\n│   ├── SessionPage.jsx       # Active session\n│   └── Profile.jsx\n│\n├── contexts/\n│   ├── AuthContext.jsx       # User auth state\n│   └── SessionContext.jsx    # Active session data\n│\n├── hooks/\n│   ├── useAuth.js            # Auth logic\n│   └── useSocket.js          # Socket.io connection\n│\n├── services/\n│   ├── api.js                # Axios instance\n│   └── socket.js             # Socket event handlers\n│\n└── utils/\n    ├── matchingUtils.js      # Session filtering\n    └── focusUtils.js         # Distraction shield logic",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "src/\n├── components/\n│   ├── auth/\n│   │   ├── LoginForm.jsx\n│   │   └── SignupForm.jsx\n│   │\n│   ├── session/\n│   │   ├── SessionCard.jsx    # Session listing\n│   │   ├── Timer.jsx         # Shared Pomodoro timer\n│   │   └── ProgressBar.jsx   # Group progress\n│   │\n│   ├── ui/\n│   │   ├── Button.jsx\n│   │   ├── Modal.jsx\n│   │   └── Alert.jsx\n│   │\n│   └── focus/\n│       ├── DistractionShieldToggle.jsx\n│       └── GoalInput.jsx\n│\n├── pages/\n│   ├── Home.jsx              # Landing\n│   ├── Dashboard.jsx         # Main view\n│   ├── SessionPage.jsx       # Active session\n│   └── Profile.jsx\n│\n├── contexts/\n│   ├── AuthContext.jsx       # User auth state\n│   └── SessionContext.jsx    # Active session data\n│\n├── hooks/\n│   ├── useAuth.js            # Auth logic\n│   └── useSocket.js          # Socket.io connection\n│\n├── services/\n│   ├── api.js                # Axios instance\n│   └── socket.js             # Socket event handlers\n│\n└── utils/\n    ├── matchingUtils.js      # Session filtering\n    └── focusUtils.js         # Distraction shield logic",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
