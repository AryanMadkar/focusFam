      "isDeleted": false,
      "boundElements": null,
      "updated": 1749200756151,
      "link": null,
      "locked": false,
      "text": "ai/\n├── services/\n│   ├── langchain/\n│   │   ├── config.js         # GPT-4/Llama3 setup\n│   │   └── ragPipeline.js    # RAG system\n│   │\n│   ├── chromaDB/\n│   │   ├── connect.js        # Vector DB connection\n│   │   └── embeddings.js     # Text chunking/embedding\n│   │\n│   └── studyAssistant/\n│       ├── qaService.js      # Question answering\n│       ├── summarizer.js     # Material summaries\n│       └── flashcards.js     # Flashcard generation\n│\n├── models/\n│   └── AIIInteraction.js     # Mongoose schema for AI logs\n│\n├── routes/\n│   └── aiRoutes.js           # POST /ai/ask, /ai/summarize\n│\n└── utils/\n    ├── promptTemplates.js    # LLM prompt engineering\n    └── safetyFilters.js      # Content moderation",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ai/\n├── services/\n│   ├── langchain/\n│   │   ├── config.js         # GPT-4/Llama3 setup\n│   │   └── ragPipeline.js    # RAG system\n│   │\n│   ├── chromaDB/\n│   │   ├── connect.js        # Vector DB connection\n│   │   └── embeddings.js     # Text chunking/embedding\n│   │\n│   └── studyAssistant/\n│       ├── qaService.js      # Question answering\n│       ├── summarizer.js     # Material summaries\n│       └── flashcards.js     # Flashcard generation\n│\n├── models/\n│   └── AIIInteraction.js     # Mongoose schema for AI logs\n│\n├── routes/\n│   └── aiRoutes.js           # POST /ai/ask, /ai/summarize\n│\n└── utils/\n    ├── promptTemplates.js    # LLM prompt engineering\n    └── safetyFilters.js      # Content moderation",
      "autoResize": true,
      "lineHeight": 1.25
