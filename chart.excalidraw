      "updated": 1749200338848,
      "link": null,
      "locked": false,
      "text": "backend/\n├── config/\n│   ├── db.js             # MongoDB connection\n│   └── jwt.js            # JWT authentication config\n│\n├── controllers/\n│   ├── authController.js     # User registration/login\n│   ├── sessionController.js  # Session management\n│   └── userController.js     # User profile/strikes\n│\n├── models/\n│   ├── User.js           # User schema\n│   └── Session.js        # Session schema\n│\n├── routes/\n│   ├── authRoutes.js     # POST /register, /login\n│   ├── sessionRoutes.js  # POST /sessions, /join, PUT /progress\n│   └── userRoutes.js     # GET/PUT /profile\n│\n├── services/\n│   ├── sessionService.js    # Session matching logic\n│   ├── realtimeService.js   # Socket.io integration\n│   └── focusShieldService.js # Distraction blocker\n│\n├── middleware/\n│   ├── authMiddleware.js    # JWT verification\n│   └── eduValidation.js     # .edu email check\n│\n├── utils/\n│   ├── errorHandler.js      # Custom error handling\n│   └── matchingAlgo.js      # Basic session matching\n│\n└── server.js                # Main entry point",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "backend/\n├── config/\n│   ├── db.js             # MongoDB connection\n│   └── jwt.js            # JWT authentication config\n│\n├── controllers/\n│   ├── authController.js     # User registration/login\n│   ├── sessionController.js  # Session management\n│   └── userController.js     # User profile/strikes\n│\n├── models/\n│   ├── User.js           # User schema\n│   └── Session.js        # Session schema\n│\n├── routes/\n│   ├── authRoutes.js     # POST /register, /login\n│   ├── sessionRoutes.js  # POST /sessions, /join, PUT /progress\n│   └── userRoutes.js     # GET/PUT /profile\n│\n├── services/\n│   ├── sessionService.js    # Session matching logic\n│   ├── realtimeService.js   # Socket.io integration\n│   └── focusShieldService.js # Distraction blocker\n│\n├── middleware/\n│   ├── authMiddleware.js    # JWT verification\n│   └── eduValidation.js     # .edu email check\n│\n├── utils/\n│   ├── errorHandler.js      # Custom error handling\n│   └── matchingAlgo.js      # Basic session matching\n│\n└── server.js                # Main entry point",
      "autoResize": true,
      "lineHeight": 1.25
    },
